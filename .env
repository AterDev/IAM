# IAM production environment placeholders
# Update these before publishing outside local development.
Authentication__Issuer=https://iam.example.com
Authentication__Jwt__ValidIssuer=https://iam.example.com
Authentication__Jwt__Sign=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
Cors__AllowedOrigins__0=https://admin.example.com

# Optional external providers
Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=
Authentication__Microsoft__CallbackUrl=/signin-microsoft
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Google__CallbackUrl=/signin-google

# Optional SMTP settings
Smtp__Host=
Smtp__Port=587
Smtp__DisplayName=
Smtp__From=
Smtp__Username=
Smtp__Password=
Smtp__EnableSsl=true
