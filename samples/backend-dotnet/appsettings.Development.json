{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Authentication": {
    "OAuth": {
      "Authority": "https://localhost:7070",
      "Audiences": [ "SampleAPI" ],
      "ClientId": "ApiClient",
      "ValidateAudience": true,
      "RequireHttpsMetadata": false
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4201",
      "https://localhost:4201"
    ]
  }
}
