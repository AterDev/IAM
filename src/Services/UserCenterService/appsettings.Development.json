{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Components": {
    "Cache": "Memory",
    "Database": "PostgreSQL"
  },
  "Authentication": {
    "OAuth": {
      "Authority": "https://localhost:9900",
      "Audiences": [ "SampleAPI" ],
      "RequireHttpsMetadata": false,
      "ValidateAudience": true
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4201",
      "https://localhost:4201"
    ]
  }
}
