{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Information",
      "ApiService.Pages.Account": "Debug",
      "IdentityMod.Managers": "Debug"
    }
  },
  "Components": {
    "Cache": "Hybrid",
    "Database": "PostgreSQL",
    "UseCors": true,
    "AuthType": "Jwt",
    "MQType": "None",
    "UseSMS": false,
    "UseSmtp": false,
    "UseAWSS3": false
  },
  "Authentication": {
    "DisplayName": "IAM",
    "Issuer": "https://localhost:9900",
    "Jwt": {
      "ValidAudiences": "IAM.SELF",
      "Sign": "IAM.TheSignKeyContent.Default",
      "ExpiredSecond": 7200
    }
  },
  "LoginSecurityPolicy": {
    "PasswordLevel": 0,
    "IsNeedVerifyCode": false,
    "PasswordExpired": 90,
    "LoginRetry": 5,
    "SessionLevel": 0
  }
}