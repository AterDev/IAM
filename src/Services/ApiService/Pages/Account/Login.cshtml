@page
@model ApiService.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "登录";
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IAM</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background:
                radial-gradient(circle at top, rgba(255, 255, 255, 0.18), transparent 42%),
                linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .login-container {
            background: rgba(255, 255, 255, 0.96);
            border: 1px solid rgba(255, 255, 255, 0.35);
            border-radius: 16px;
            box-shadow: 0 18px 50px rgba(31, 41, 55, 0.22);
            width: 100%;
            max-width: 420px;
            padding: 40px 38px 36px;
            backdrop-filter: blur(8px);
        }
        
        .logo {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .logo h1 {
            color: #667eea;
            font-size: 30px;
            font-weight: 600;
        }
        
        .logo p {
            color: #6c757d;
            font-size: 14px;
            margin-top: 8px;
        }
        
        .client-info {
            background: linear-gradient(180deg, #f8faff 0%, #eef2ff 100%);
            border: 1px solid #dbe3ff;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 24px;
        }
        
        .client-info p {
            color: #495057;
            font-size: 14px;
            line-height: 1.6;
        }
        
        .client-info strong {
            color: #212529;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            color: #495057;
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 8px;
        }
        
        input[type="text"],
        input[type="password"] {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 14px;
            background: #fff;
            transition: all 0.3s;
        }

        input[type="text"]::placeholder,
        input[type="password"]::placeholder {
            color: #94a3b8;
        }
        
        input[type="text"]:focus,
        input[type="password"]:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        input.input-validation-error {
            border-color: #dc3545;
        }

        input.input-validation-error:focus {
            border-color: #dc3545;
            box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1);
        }
        
        .checkbox-group {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        
        input[type="checkbox"] {
            margin-right: 8px;
            width: 16px;
            height: 16px;
        }
        
        .checkbox-group label {
            margin: 0;
            font-weight: 400;
        }
        
        .submit-btn {
            width: 100%;
            padding: 14px;
            background: #667eea;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
            letter-spacing: 0.5px;
        }
        
        .submit-btn:hover {
            background: #5568d3;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }
        
        .submit-btn:active {
            transform: translateY(0);
        }
        
        .error-message {
            background: #f8d7da;
            color: #721c24;
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 14px;
            border: 1px solid #f5c6cb;
        }

        .text-danger,
        .field-validation-error {
            color: #dc3545;
            font-size: 13px;
            margin-top: 5px;
            display: block;
        }

        .validation-summary-errors {
            background: #f8d7da;
            color: #721c24;
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 14px;
            border: 1px solid #f5c6cb;
            display: block;
        }

        .validation-summary-valid {
            display: none;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }
        
        .links {
            margin-top: 24px;
            text-align: center;
            display: flex;
            justify-content: center;
            gap: 18px;
            flex-wrap: wrap;
        }
        
        .links a {
            color: #667eea;
            text-decoration: none;
            font-size: 14px;
        }
        
        .links a:hover {
            text-decoration: underline;
        }
        
        .return-link {
            text-align: center;
            margin-top: 20px;
        }
        
        .return-link a {
            color: #6c757d;
            text-decoration: none;
            font-size: 14px;
        }
        
        .return-link a:hover {
            color: #495057;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="logo">
            <h1>🔐 IAM</h1>
            <p>身份与访问管理系统</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ClientName))
        {
            <div class="client-info">
                <p><strong>@Model.ClientName</strong> 请求访问您的账号</p>
            </div>
        }

        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            @Html.AntiForgeryToken()
            
            <div class="form-group">
                <label asp-for="Username">用户名或邮箱</label>
                <input asp-for="Username" type="text" placeholder="请输入用户名或邮箱" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">密码</label>
                <input asp-for="Password" type="password" placeholder="请输入密码" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="checkbox-group">
                <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                <label for="rememberMe">记住我</label>
            </div>

            <button type="submit" class="submit-btn">登录</button>

            <div class="links">
                <a href="/Account/Register?returnUrl=@Model.ReturnUrl">注册账号</a>
                <a href="/Account/ForgotPassword">忘记密码？</a>
            </div>

            <div class="return-link">
                @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                {
                    <a href="@Model.ReturnUrl">← 取消并返回</a>
                }
            </div>
        </form>
    </div>
</body>
</html>
