{
  "name": "front-sample-service",
  "version": "1.0.0",
  "description": "Front sample service with IAM OIDC integration",
  "scripts": {
    "ng": "ng",
    "start": "pnpm i18n:keys && ng serve --port 4201",
    "build": "pnpm i18n:keys && ng build",
    "watch": "pnpm i18n:keys && ng build --watch --configuration development",
    "i18n:keys": "node scripts/i18n-keys.js",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/material": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "angular-auth-oidc-client": "22.0.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.33.2"
}
